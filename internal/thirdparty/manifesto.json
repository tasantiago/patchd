{
  "version": 1,
  "apps": [
    {"id": "google-chrome", "os": "windows", "name": "Google Chrome", "category": "feed",
     "publisher": "^Google LLC$", "match": "^Google Chrome$",
     "source": {"type": "chrome", "id": "win64"}},
    {"id": "mozilla-firefox", "os": "windows", "name": "Mozilla Firefox", "category": "feed",
     "publisher": "^Mozilla", "match": "^Mozilla Firefox( \\(|$)",
     "source": {"type": "firefox", "id": "LATEST_FIREFOX_VERSION"}},
    {"id": "mozilla-firefox-esr", "os": "windows", "name": "Mozilla Firefox ESR", "category": "feed",
     "publisher": "^Mozilla", "match": "^Mozilla Firefox ESR( \\(|$)",
     "source": {"type": "firefox", "id": "FIREFOX_ESR"},
     "note": "compara com a ESR mais nova; uma máquina numa linha ESR anterior aparece desatualizada"},
    {"id": "mozilla-maintenance", "os": "windows", "name": "Mozilla Maintenance Service", "category": "ignore",
     "publisher": "^Mozilla", "match": "^Mozilla Maintenance Service$",
     "note": "serviço de atualização do Firefox, avaliado junto com ele"},
    {"id": "7zip", "os": "windows", "name": "7-Zip", "category": "feed",
     "publisher": "^Igor Pavlov$", "match": "^7-Zip( |$)",
     "source": {"type": "winget", "id": "7zip.7zip"}},
    {"id": "adobe-acrobat", "os": "windows", "name": "Adobe Acrobat (Reader)", "category": "feed",
     "publisher": "^Adobe", "match": "^Adobe Acrobat( Reader)?( DC)? \\(64-bit\\)$",
     "source": {"type": "winget", "id": "Adobe.Acrobat.Reader.64-bit"},
     "note": "trilha Continuous; o Acrobat da trilha Classic (2020, 2024) tem outra numeração"},
    {"id": "notepad-plus-plus", "os": "windows", "name": "Notepad++", "category": "feed",
     "publisher": "^Notepad\\+\\+ Team$", "match": "^Notepad\\+\\+( \\(|$)",
     "source": {"type": "winget", "id": "Notepad++.Notepad++"}},
    {"id": "vscode", "os": "windows", "name": "Visual Studio Code", "category": "feed",
     "publisher": "^Microsoft Corporation$", "match": "^Microsoft Visual Studio Code( \\(User\\))?$",
     "source": {"type": "winget", "id": "Microsoft.VisualStudioCode"}},
    {"id": "powershell-7", "os": "windows", "name": "PowerShell 7", "category": "feed",
     "publisher": "^Microsoft Corporation$", "match": "^PowerShell 7[.\\- ]",
     "source": {"type": "winget", "id": "Microsoft.PowerShell"},
     "note": "compara com a versão mais nova; uma máquina na LTS anterior aparece desatualizada"},
    {"id": "python-3.14", "os": "windows", "name": "Python 3.14", "category": "feed",
     "publisher": "^Python Software Foundation$", "match": "^Python (3\\.14\\.\\d+)( \\((32|64)-bit\\))?$",
     "version_from": "name", "source": {"type": "winget", "id": "Python.Python.3.14"},
     "note": "o registro guarda \"3.14-64\" como versão; a versão completa vem do nome"},
    {"id": "libreoffice", "os": "windows", "name": "LibreOffice", "category": "feed",
     "publisher": "^The Document Foundation$", "match": "^LibreOffice [0-9.]+$",
     "source": {"type": "winget", "id": "TheDocumentFoundation.LibreOffice"},
     "note": "o winget acompanha a linha mais nova; uma máquina na linha estável anterior aparece desatualizada"},
    {"id": "microsoft-edge", "os": "windows", "name": "Microsoft Edge", "category": "os-vendor",
     "publisher": "^Microsoft", "match": "^Microsoft Edge$",
     "note": "CVEs no MSRC (Microsoft Edge (Chromium-based)); ainda não avaliado pelo patchd"},
    {"id": "microsoft-365-apps", "os": "windows", "name": "Microsoft 365 Apps", "category": "os-vendor",
     "publisher": "^Microsoft", "match": "^Microsoft 365 Apps",
     "note": "CVEs no MSRC (Microsoft 365 Apps, por canal); ainda não avaliado pelo patchd"},
    {"id": "teams-meeting-addin", "os": "windows", "name": "Suplemento de reunião do Teams", "category": "os-vendor",
     "publisher": "^Microsoft", "match": "^Microsoft Teams Meeting Add-in",
     "note": "atualizado junto com o Teams"},
    {"id": "vcredist-2008", "os": "windows", "name": "Visual C++ 2008 Redistributable", "category": "eol",
     "publisher": "^Microsoft", "match": "^Microsoft Visual C\\+\\+ 2008 Redistributable",
     "note": "fim do suporte estendido em 2018-04-10"},
    {"id": "vcredist-2010", "os": "windows", "name": "Visual C++ 2010 Redistributable", "category": "eol",
     "publisher": "^Microsoft", "match": "^Microsoft Visual C\\+\\+ 2010 ",
     "note": "fim do suporte estendido em 2020-07-14"},
    {"id": "vcredist-2012", "os": "windows", "name": "Visual C++ 2012 Redistributable", "category": "eol",
     "publisher": "^Microsoft", "match": "^Microsoft Visual C\\+\\+ 2012 Redistributable",
     "note": "fim do suporte estendido em 2023-01-10"},
    {"id": "vcredist-2013", "os": "windows", "name": "Visual C++ 2013 Redistributable", "category": "eol",
     "publisher": "^Microsoft", "match": "^Microsoft Visual C\\+\\+ 2013 Redistributable",
     "note": "fim do suporte estendido em 2024-04-09"},
    {"id": "access-database-engine-2010", "os": "windows", "name": "Access Database Engine 2010", "category": "eol",
     "publisher": "^Microsoft", "match": "^Microsoft Access database engine 2010",
     "note": "fim do suporte do Office 2010 em 2020-10-13"},
    {"id": "sql-server-2012-native-client", "os": "windows", "name": "SQL Server 2012 Native Client", "category": "eol",
     "publisher": "^Microsoft", "match": "^Microsoft SQL Server 2012 Native Client",
     "note": "fim do suporte estendido do SQL Server 2012 em 2022-07-12"},

    {"id": "google-chrome", "os": "macos", "name": "Google Chrome", "category": "feed",
     "match": "^Google Chrome$", "source": {"type": "chrome", "id": "mac"}},
    {"id": "mozilla-firefox", "os": "macos", "name": "Mozilla Firefox", "category": "feed",
     "match": "^Firefox$", "source": {"type": "firefox", "id": "LATEST_FIREFOX_VERSION"}},
    {"id": "vscode", "os": "macos", "name": "Visual Studio Code", "category": "feed",
     "match": "^Visual Studio Code$", "source": {"type": "homebrew", "id": "visual-studio-code"}}
  ]
}
