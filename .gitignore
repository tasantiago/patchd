# Binários e artefatos de build
/bin/
/dist/

# Variáveis locais (UID/GID e, no futuro, segredos de desenvolvimento)
.env

# Ambiente de desenvolvimento: histórico do shell e certificados locais
/.docker/zsh/history/
/.docker/certs/*.crt
# known_hosts do container de desenvolvimento
/.docker/ssh/

# Segredos do compose de produção
/deploy/secrets/

# Atualização do agente (Aula 5.4): a chave privada e a pasta de versões nunca entram no git
*.key
/releases/

# Scripts de aplicação das aulas e marcas de download do Windows (WSL): nunca entram no git
/aula-*.sh
*:Zone.Identifier
/lab-*.sh
/explora-*.sh
