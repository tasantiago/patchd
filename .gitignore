# Binários e artefatos de build
/bin/
/dist/

# Variáveis locais (UID/GID e, no futuro, segredos de desenvolvimento)
.env

# Ambiente de desenvolvimento: histórico do shell e certificados locais
/.docker/zsh/history/
/.docker/certs/*.crt
# known_hosts do container de desenvolvimento
/.docker/ssh/
# Ajustes do compose só desta máquina (Aula 9.1b; modelo em .docker/compose.override.exemplo.yml)
/docker-compose.override.yml

# Segredos, TLS e configuração do compose de produção (Aula 9.3: o .env.exemplo entra)
/deploy/secrets/
/deploy/tls/
# Cópias do banco (Aula 10.1): têm tudo o que está no banco
/deploy/backups/
# Última atualização do servidor (Aula 10.4): é deste host
/deploy/.atualizacao

# Atualização do agente (Aula 5.4): a chave privada e a pasta de versões nunca entram no git
*.key
/releases/

# Scripts de aplicação das aulas e marcas de download do Windows (WSL): nunca entram no git
/aula-*.sh
*:Zone.Identifier
/lab-*.sh
/explora-*.sh

# Relatórios do ZAP (Aula 20.4): têm os endereços e as respostas do lab
/zap/relatorios/
