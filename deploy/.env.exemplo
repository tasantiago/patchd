# Configuração do compose de produção (Aula 9.3). Copie para deploy/.env e preencha.
# O deploy/.env fica fora do git: nomes de host, domínio e grupos do ambiente real só aqui.

# A URL HTTPS pela qual os agentes alcançam o servidor (o nome do certificado).
PATCHD_PUBLIC_URL=https://patchd.exemplo:8443

# Portas no host. Para um teste local, 127.0.0.1 e portas que não colidam com o patchd-dev.
PATCHD_TLS_BIND=0.0.0.0
PATCHD_TLS_PORT=8443
PATCHD_HTTP_BIND=0.0.0.0
PATCHD_HTTP_PORT=8080

# Porta HTTP: transição dos agentes e cache. true quando ninguém mais usar HTTP
# (machine list sem "ainda por HTTP"). Para fechar a porta de vez: PATCHD_HTTP_LISTEN_ADDR=
PATCHD_HTTP_CACHE_ONLY=false

# Cache de repositórios anunciado aos agentes Linux (proxy do apt, em HTTP). Vazio: sem anúncio.
PATCHD_REPO_CACHE_URL=

# Pastas do host (relativas a deploy/).
PATCHD_TLS_DIR=./tls
PATCHD_RELEASES_HOST_DIR=../releases

PATCHD_TIMEZONE=America/Porto_Velho
# Nome no topo do painel (até 40 caracteres).
PATCHD_PANEL_TITLE=patchd
PATCHD_LOG_LEVEL=info

# AD (vazio = só usuários locais).
PATCHD_LDAP_HOST=
PATCHD_LDAP_DOMAIN=
PATCHD_LDAP_BASE_DN=
PATCHD_LDAP_ADMIN_GROUP=
PATCHD_LDAP_READ_GROUP=

# RHBK (Aula 9.4; vazio = desligado). O segredo do cliente fica em deploy/secrets/oidc_client_secret.
# O endereço de volta é PATCHD_PUBLIC_URL + /painel/oidc/retorno (cadastre-o no cliente do RHBK).
PATCHD_OIDC_ISSUER=
PATCHD_OIDC_CLIENT_ID=patchd-painel
PATCHD_OIDC_ROLES_CLAIM=groups
PATCHD_OIDC_ADMIN_ROLE=patchd-admin
PATCHD_OIDC_READ_ROLE=patchd-leitura

# Métricas (Aula 10.2): porta própria, HTTPS, token em deploy/secrets/metrics_token.
# Vazio desliga. BIND=127.0.0.1: só o próprio host; para o Prometheus de outra máquina,
# o IP do host aqui e o firewall liberando só o IP do Prometheus.
PATCHD_METRICS_LISTEN_ADDR=:9090
PATCHD_METRICS_BIND=127.0.0.1
PATCHD_METRICS_PORT=9090

# Retenção do banco (Aula 10.5). Histórico: inventários e buscas além do atual de cada
# máquina (30 a 3650 dias). Jobs: jobs e campanhas encerrados (0 = guardar sempre, ou 90 a
# 3650). Antes de mudar: ./deploy/compose.sh exec server /patchd-server retention
PATCHD_RETENTION_HISTORY_DAYS=90
PATCHD_RETENTION_JOBS_DAYS=400

# Notificações por e-mail (Aula 18.5; vazio = desligadas). O SMTP da instituição, host:porta
# (587 com starttls; 465 com tls; none só para um relay interno sem TLS e sem login).
# Destinatários separados por vírgula. Com login, a senha vai em deploy/secrets/smtp_password.
# CA interna do SMTP: copie o PEM para deploy/tls/ e use PATCHD_SMTP_CA_FILE=/run/patchd/tls/ARQUIVO.
PATCHD_SMTP_ADDR=
PATCHD_SMTP_FROM=
PATCHD_NOTIFY_TO=
PATCHD_SMTP_TLS=starttls
PATCHD_SMTP_USER=
PATCHD_SMTP_CA_FILE=

# Versão em uso (Aula 10.4): anotadas pelo ./deploy/atualizar.sh; não edite à mão.
PATCHD_VERSION=
PATCHD_COMMIT=
