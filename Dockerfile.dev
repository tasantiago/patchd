# Ambiente de DESENVOLVIMENTO do patchd: toolchain Go + zsh, rodando como usuário comum.
# Não é a imagem de produção do servidor (essa fica em deploy/, Aula 1.4).
FROM golang:1.27-trixie

# UID/GID do usuário do host, para os arquivos do bind mount terem o dono certo.
ARG UID=1000
ARG GID=1000

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=America/Porto_Velho

USER root

# CA corporativa (opcional): todo .crt em .docker/certs entra no repositório de confiança do sistema.
# Soma-se às CAs públicas em vez de substituí-las.
COPY .docker/certs/ /usr/local/share/ca-certificates/
RUN update-ca-certificates

RUN apt-get update && apt-get install -y --no-install-recommends \
        git \
        zsh \
        curl \
        wget \
        fonts-powerline \
        lynx \
        tzdata \
        openssh-client \
    && ln -snf "/usr/share/zoneinfo/$TZ" /etc/localtime \
    && echo "$TZ" > /etc/timezone \
    && rm -rf /var/lib/apt/lists/*

# Usuário de desenvolvimento com o mesmo UID/GID do host.
RUN groupadd -g "$GID" appuser \
    && useradd -m -u "$UID" -g "$GID" -s /usr/bin/zsh appuser

# Toolchain: GOPATH e cache de build na home do usuário (montados como volumes no compose).
# CGO_ENABLED=0: binários estáticos, requisito RNF-02.
ENV HOME=/home/appuser \
    GOPATH=/home/appuser/go \
    GOCACHE=/home/appuser/.cache/go-build \
    CGO_ENABLED=0
ENV PATH=/usr/local/go/bin:/home/appuser/go/bin:${PATH}

# As pastas precisam existir com o dono certo ANTES do primeiro uso dos volumes nomeados:
# o Docker copia dono e conteúdo da imagem para o volume vazio.
RUN mkdir -p "$GOPATH" "$GOCACHE" /home/appuser/app /home/appuser/zsh \
    && chown -R appuser:appuser /home/appuser

USER appuser
WORKDIR /home/appuser/app

# Mesmo tema e plugins do projeto do relatório (versão fixada do instalador).
RUN sh -c "$(wget -O- https://github.com/deluan/zsh-in-docker/releases/download/v1.1.5/zsh-in-docker.sh)" -- \
    -t https://github.com/romkatv/powerlevel10k \
    -p git \
    -p git-flow \
    -p https://github.com/zdharma-continuum/fast-syntax-highlighting \
    -p https://github.com/zsh-users/zsh-autosuggestions \
    -p https://github.com/zsh-users/zsh-completions \
    -a 'export TERM=xterm-256color'

# Tema, histórico persistente e comentários (#) aceitos em comandos colados.
RUN echo '[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh' >> ~/.zshrc \
    && echo 'HISTFILE=/home/appuser/zsh/.zsh_history' >> ~/.zshrc \
    && echo 'setopt interactivecomments' >> ~/.zshrc

# O container só precisa ficar de pé; você entra com "docker compose exec dev zsh".
CMD ["sleep", "infinity"]